# MANAGED BY ANSIBLE — ansible/templates/containers/adsb-web/default.conf.j2
#
# The allow-list is rendered from `lan_vhost_allow` in group_vars/all.yml, the
# same variable dmz-vhosts.yml uses for the vhosts still on VMs. One source, so
# adding a site LAN cannot fix the VMs and silently miss the containers.
server {
    listen 80;
    # TLS ON THE CONTAINER ITSELF, not only on the hub. adsb.n0gq.org is
    # split-horizon: on the LAN it resolves to this container (10.1.17.41),
    # not to the hub, so the hub's certificate never enters the picture here.
    # The hub sends HSTS with includeSubDomains for n0gq.org, and once a
    # browser has seen that it will REFUSE to fall back to http for any
    # *.n0gq.org name -- so a LAN vhost on :80 only becomes unreachable with
    # no error a user can act on. That is exactly how illumio.n0gq.org and
    # maps.n0gq.org each broke on 2026-09-09.
    #
    # One server block on both ports: plain http on the LAN keeps working for
    # anything that wants it, and https works for everything else.
    listen 443 ssl;
    ssl_certificate     {{ lan_tls_dir }}/fullchain.pem;
    ssl_certificate_key {{ lan_tls_dir }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # radar.n0gq.org: an INTERNAL-ONLY name for the same radar (office DNS,
    # no public record, so no public AAAA). adsb.n0gq.org has a public AAAA on
    # purpose (IPv6-only clients outside, 2026-09-12), and once the office LAN
    # got global IPv6 back, LAN browsers preferred it and hairpinned through
    # the Oregon hub over Starlink -- where the websocket stalled for up to
    # 24 s and every plane froze (2026-10-05). radar.n0gq.org stays on the LAN
    # until internal IPv6 exists (skynet todo: owned ULA, ipv6.md 3).
    server_name adsb.n0gq.org radar.n0gq.org;

{% for a in lan_vhost_allow %}
    allow {{ a.cidr }};{% if a.why is defined %}   # {{ a.why }}{% endif %}

{% endfor %}
    deny  all;

    # Kept from the VM's config: without it nginx builds redirects as absolute
    # URLs using the listen port, which breaks behind the hub's TLS proxy.
    absolute_redirect off;
    client_max_body_size 32m;

    access_log /var/log/nginx/adsb.access.log;
    error_log  /var/log/nginx/adsb.error.log;

    location /ws {
        proxy_pass         http://127.0.0.1:8765/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_read_timeout 86400s;
    }

    # The UI assets must not be heuristically cached.
    #
    # ui_web.py's HTTP server sends Last-Modified and nothing else -- no
    # Cache-Control, no ETag -- and a browser given only Last-Modified is
    # free to invent its own freshness lifetime and serve a stale copy
    # without asking. That is invisible and it is expensive: a deployed fix
    # appears not to have worked, so the next thing changed is the code that
    # was already correct.
    #
    # no-cache (not no-store) still allows a conditional request, so an
    # unchanged file is a 304 and costs nothing. The 10 MB opening snapshot
    # over the WebSocket dwarfs these files anyway.
    location ~* \.(html|js|css)$ {
        proxy_pass       http://127.0.0.1:8086;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Weather from adsb-hub, passed through (and cached a minute) by the app.
    location /wx {
        proxy_pass       http://127.0.0.1:8086;
        proxy_set_header Host $host;
    }

    # THE RADAR IS THE ONLY PAGE (owner's request, 2026-10-05). Every path
    # that is not an asset above redirects to /radar.html -- the bare name
    # used to get the app server's directory listing. (An .html/.js/.css path
    # that is not a real file is redirected by the app itself, ui_web.py.)
    # A redirect, not a rewrite: radar.html loads radar.js by a RELATIVE
    # path, so serving it at /some/path would ask for /some/path/radar.js.
    # The Location is relative (absolute_redirect off, above), so it works
    # behind the hub's proxy too.
    location / {
        return 302 /radar.html;
    }
}
