[Unit]
Description=ADS-B Watch (web radar, internet feeds)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jfrancis
WorkingDirectory=/home/jfrancis/adsb-watch
# Credentials (GOVT_DATA_USER / GOVT_DATA_PASS, optional OPENSKY_*) live here.
EnvironmentFile=/etc/adsb-watch.env
Environment=PYTHONUNBUFFERED=1
# Same parameters as the interactive run on 10.1.0.10, minus the local SDR:
# 10.1.17.20 has no RTL-SDR, so --no-launch-dump1090 and traffic comes from
# --internet. Web UI on :8086 (HTTP) + :8765 (WS); nginx on us/eu fronts both.
#
# --expiry 30 (default 10) because this instance is fed by an aggregator, not
# by RF.  adsb.lol rate-limits, and a 429 backs the poller off 2 -> 4 -> 8 s;
# with a 10 s expiry the whole fleet was deleted before the next successful
# poll, so aircraft appeared for ~10 s, faded to predicted, vanished, and
# repeated on a ~27 s cycle.  A 10 s expiry is right for RF, where silence
# really does mean out of range; for a polled feed it just means "between
# polls".  At 30 s a backoff makes aircraft go dim (dead-reckoned), not gone.
# The UI still marks anything over PREDICT_STALE_THRESHOLD_S (3 s) predicted,
# so nothing is presented as fresher than it is.
# REFERENCE COPY ONLY -- ansible/provision.yml writes the unit that actually
# runs on 10.1.17.41, and it is the authoritative one. These two diverged once
# (the deployed unit had --expiry/--predict-stale and the playbook did not, so
# a deploy would have silently undone them). Change both or neither.
#
# NOTE the govt-data URL below is stale: govt-data moved off dmz to
# 10.1.17.42, and 10.1.17.20:8091 no longer answers. provision.yml has the
# current address.
#
# The web scope-centre selector is enabled. There is one observer, so any
# viewer who re-centres moves the scope for everyone -- acceptable because the
# public vhost is behind basic auth (skynet configure.yml, tag nginx_adsb).
# Add --no-web-recenter to refuse it outright.
ExecStart=/home/jfrancis/adsb-watch/venv/bin/python3 /home/jfrancis/adsb-watch/main.py \
    --web --web-port 8765 --http-port 8086 \
    --no-launch-dump1090 \
    --kml \
    --fixed-lat 39.3553696 --fixed-lon -104.6729929 --fixed-alt-ft 6750 \
    --govt-data-url http://10.1.17.20:8091 \
    --internet \
    --expiry 30 \
    --predict-stale 8
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
